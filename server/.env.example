# Copy to server/.env and fill in. server/.env is git-ignored.
# All values below were previously hardcoded in server.py and are in git
# history: ROTATE them, do not reuse the old values.

# Required — server.py refuses to start without these.
FLASK_SECRET_KEY=          # long random string; rotating it logs out Flask sessions
DB_PASSWORD=
JWT_SECRET=                # MUST equal JWT_SECRET in the Node backend .env
SMTP_PASSWORD=             # Gmail app password for SMTP_SENDER_EMAIL

# Optional — defaults shown.
# DB_HOST=64.227.6.9
# DB_USER=kshiti
# SMTP_SENDER_EMAIL=noreply@kiotel.co
# CORS_ORIGINS=https://portal.kiotel.co,https://careers.kiotel.co
# FLASK_DEBUG=0            # dev only; never 1 in production
# PORT=8080                # dev server only; gunicorn takes -b
