# Without this the build context is ~2.6 GB: node_modules (981 MB) plus a
# stale .next (1.6 GB). Both are regenerated inside the image.
node_modules
.next
out

.git
.gitignore

# NEXT_PUBLIC_* values are supplied as build args by compose, not from a file
# copied into the image.
.env
.env.*

npm-debug.log*
.npm
README.md
Dockerfile
.dockerignore
.eslintrc.json
